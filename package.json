{
  "name": "halftone-flowers",
  "version": "0.2.0",
  "description": "Halftone flower field React component built with WebGL2 and TypeScript.",
  "keywords": [
    "react",
    "react-component",
    "halftone",
    "flowers",
    "flower field",
    "generative",
    "canvas",
    "webgl2",
    "animation",
    "background",
    "bees",
    "butterflies"
  ],
  "homepage": "https://lucasjin.ca/flowers",
  "bugs": {
    "url": "https://github.com/LucasHJin/halftone-flowers/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LucasHJin/halftone-flowers.git"
  },
  "license": "MIT",
  "author": "Lucas Jin",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.build.json",
    "build:demo": "tsc --noEmit && vite build --mode demo",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dialkit": "^2.0.2",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
